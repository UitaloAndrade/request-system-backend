SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/db_requestsystem
DB_USERNAME=postgres
DB_PASSWORD=

SHOW_SQL=true

# Gere uma chave aleatória com pelo menos 32 bytes. Por exemplo, usando PowerShell com Java instalado:
# $bytes = New-Object byte[] 32
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# $rng.Dispose()
# [Convert]::ToBase64String($bytes)

JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600